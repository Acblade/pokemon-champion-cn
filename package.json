{
  "name": "pokemon-champion-cn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "vite",
    "build-data": "tsx scripts/build-data.ts",
    "update-usage": "tsx scripts/update-usage-data.ts",
    "update-team-shares": "tsx scripts/update-team-shares.ts",
    "audit-data": "tsx scripts/audit-champions-update.ts",
    "verify-update": "npm run audit-data && npm run build && npm run lint && npx tsx scripts/test-champions-calc.ts",
    "import-manual-trainers": "tsx scripts/import-manual-trainer-rankings.ts",
    "mobile-sync-trainers": "node scripts/mobile-sync-trainer-rankings.mjs",
    "build": "tsc -b && vite build",
    "build:sites": "tsc -b && vite build --mode sites && node scripts/prepare-sites-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openai/sites-vite-plugin": "^0.1.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
